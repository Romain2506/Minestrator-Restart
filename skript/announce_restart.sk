# ============================================================
# announce_restart.sk
#
# Annonce dans le chat le redémarrage programmé du serveur (celui
# déclenché par le workflow GitHub Minestrator-Restart), avec un
# rappel 5 minutes avant.
#
# Pré-requis : addon "Reqn" UNIQUEMENT (léger, juste pour l'HTTP) :
#   https://github.com/btk5h/reqn/releases
# Pas besoin de JSON : le fichier distant est au format texte tout
# simple "frozen=0;seconds_remaining=8043", lu avec "split at" (natif Skript).
#
# Remplace l'URL ci-dessous si tu changes de dépôt/compte GitHub.
# ============================================================

options:
	schedule_url: "https://raw.githubusercontent.com/Romain2506/Minestrator-Restart/main/restart_schedule.txt"

# Variables persistantes (sauvegardées automatiquement par Skript) :
# {restart::countdown}   -> secondes restantes avant le prochain redémarrage (décompte chaque minute)
# {restart::warned_5min} -> true si le rappel "5 minutes" a déjà été annoncé pour ce créneau
# {restart::fired}       -> true si l'annonce finale a déjà été faite pour ce créneau

# --- 1. Toutes les 5 minutes : on va chercher l'info à jour sur GitHub ---
every 5 minutes:
	send a request to {@schedule_url}
	set {_resp} to the last http response
	set {_code} to {_resp}'s status code

	if {_code} is 200:
		set {_body} to {_resp}'s body
		set {_frozen} to "0"
		set {_seconds} to "0"

		set {_fields::*} to {_body} split at ";"
		loop {_fields::*}:
			set {_kv::*} to loop-value split at "="
			if {_kv::1} is "frozen":
				set {_frozen} to {_kv::2}
			if {_kv::1} is "seconds_remaining":
				set {_seconds} to {_kv::2}

		if {_frozen} is "1":
			set {restart::countdown} to -1
		else:
			set {restart::countdown} to {_seconds} parsed as number
			set {restart::warned_5min} to false
			set {restart::fired} to false

# --- 2. Toutes les minutes : le compte à rebours descend et on annonce au bon moment ---
every 1 minute:
	if {restart::countdown} is set:
		if {restart::countdown} > 0:
			subtract 60 from {restart::countdown}

			if {restart::countdown} <= 300:
				if {restart::warned_5min} is not set:
					broadcast "&e&l[Serveur] &eRedémarrage dans &c5 minutes&e. Pense à terminer ce que tu fais !"
					set {restart::warned_5min} to true

			if {restart::countdown} <= 0:
				if {restart::fired} is not set:
					broadcast "&c&l[Serveur] &cRedémarrage en cours...&r &7(maintenance automatique)"
					set {restart::fired} to true

# --- 3. Commande pour un joueur/op : connaître le temps restant avant le prochain redémarrage ---
command /prochainredemarrage:
	permission: minestrator.restart.info
	aliases: /restarttime, /nextrestart
	trigger:
		if {restart::countdown} is not set:
			send "&7Aucune information de redémarrage disponible pour le moment." to player
			stop trigger

		if {restart::countdown} < 0:
			send "&7Le serveur est en pause de maintenance (1h-6h), pas de redémarrage prévu pour l'instant." to player
			stop trigger

		set {_totalminutes} to round({restart::countdown} / 60)
		send "&a[Serveur] &eProchain redémarrage dans &6~%{_totalminutes}% minute(s)" to player
